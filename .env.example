# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use for extraction (any OpenRouter model string)
# Good options:
#   openai/gpt-4o-mini        ← default (cheap, fast, accurate)
#   openai/gpt-4o             ← better for complex profiles
#   anthropic/claude-3-haiku  ← fast alternative
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Browser ───────────────────────────────────────────────────────────────────
# Path to the dedicated Chrome profile directory.
# Using a project-local folder avoids conflicts with your personal Chrome.
PROFILE_DIR=./chrome_profile

# Set to true ONLY after you have logged in once and confirmed auth works.
# Keep false during first-run login.
HEADLESS=false

# Navigation timeout in milliseconds
NAV_TIMEOUT_MS=60000

# Maximum characters of page text sent to the LLM (controls cost)
MAX_TEXT_CHARS=12000
